# Copy to .env for local development (never commit real values).
PORT=8080
MONGODB_URI=mongodb://localhost:27017/hwanscord
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Cloudflare Realtime TURN (optional; STUN-only when unset)
#CF_TURN_KEY_ID=
#CF_TURN_API_TOKEN=
#CF_ACCOUNT_ID=
#CF_ANALYTICS_TOKEN=
#TURN_MONTHLY_BUDGET_GB=800
# Resend mail (optional; mail disabled when unset)
#RESEND_API_KEY=
#MAIL_FROM=HWANSCORD <noreply@kimhwan.kr>
#MAIL_DAILY_LIMIT=80
# GitHub OAuth App (optional)
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#PUBLIC_URL=http://localhost:5173
